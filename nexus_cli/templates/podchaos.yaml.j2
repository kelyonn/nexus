{# PRD §7.6 mandates a gentle default blast radius ("kills exactly one pod at
   random, not all replicas"). The legacy demo's Schedule used
   `mode: fixed-percent, value: "50"`; this template deliberately uses
   `mode: one` instead, since the functional spec's stated product behavior
   takes precedence over the legacy manifest's literal historical value. #}
apiVersion: chaos-mesh.org/v1alpha1
kind: Schedule
metadata:
  name: {{ app.name }}-chaos-schedule
  namespace: chaos-mesh
  labels:
    app: {{ app.name }}
    managed-by: nexus
spec:
  # chaosSchedule is already restricted to a cron-field charset that can't
  # contain quotes/newlines (config.py's _cron validator), so `| tojson`
  # here is pure defense in depth, applied for consistency with every other
  # field this project interpolates into generated manifests.
  schedule: {{ platform.chaosSchedule | tojson }}
  historyLimit: 3
  concurrencyPolicy: Forbid
  type: PodChaos
  podChaos:
    action: pod-kill
    mode: one
    selector:
      namespaces:
        - {{ app.name }}
      labelSelectors:
        app: {{ app.name }}
    duration: "1m"
