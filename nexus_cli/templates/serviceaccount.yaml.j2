apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ app.name }}
  namespace: {{ app.name }}
  labels:
    app: {{ app.name }}
    managed-by: nexus
# Dedicated per app rather than letting pods fall back to the namespace's
# `default` ServiceAccount, whose token grants whatever RBAC anything else
# in the namespace happens to have accumulated. See deployment.yaml.j2's pod
# spec for the (authoritative) pod-level automountServiceAccountToken: false.
automountServiceAccountToken: false
