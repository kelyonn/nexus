apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ app.name }}
  namespace: argocd
  labels:
    managed-by: nexus
spec:
  project: default
  source:
    repoURL: {{ platform.repoURL }}
    targetRevision: {{ platform.branch }}
    path: k8s
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ app.name }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
