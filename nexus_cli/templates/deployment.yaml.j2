apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app.name }}
  namespace: {{ app.name }}
  labels:
    app: {{ app.name }}
    managed-by: nexus
spec:
  replicas: {{ app.replicas }}
  selector:
    matchLabels:
      app: {{ app.name }}
  template:
    metadata:
      labels:
        app: {{ app.name }}
    spec:
{% if app.registry %}
      imagePullSecrets:
      - name: {{ app.registry_secret_name }}
{% endif %}
      containers:
      - name: {{ app.name }}
        image: {{ app.image | tojson }}
        imagePullPolicy: {{ app.imagePullPolicy | tojson }}
        ports:
        - containerPort: {{ app.port }}
{% if app.env %}
        env:
{% for var in app.env %}
        # `| tojson` on both fields: `name` is schema-validated to a safe
        # charset (config.py's EnvVar), but `value` is deliberately free
        # text (it's the one field users need to put arbitrary strings in),
        # so escaping here is the actual fix, not defense in depth. See
        # docs/INTERVIEW-BRIEF.md for the injection this closes.
        - name: {{ var.name | tojson }}
          value: {{ var.value | tojson }}
{% endfor %}
{% endif %}
        resources:
          requests:
            cpu: {{ app.resources.requests.cpu | tojson }}
            memory: {{ app.resources.requests.memory | tojson }}
          limits:
            cpu: {{ app.resources.limits.cpu | tojson }}
            memory: {{ app.resources.limits.memory | tojson }}
        readinessProbe:
          httpGet:
            path: {{ app.healthPath | tojson }}
            port: {{ app.port }}
          initialDelaySeconds: 3
          periodSeconds: 5
          timeoutSeconds: 2
          failureThreshold: 3
        livenessProbe:
          httpGet:
            path: {{ app.healthPath | tojson }}
            port: {{ app.port }}
          initialDelaySeconds: 5
          periodSeconds: 10
          timeoutSeconds: 2
          failureThreshold: 3
