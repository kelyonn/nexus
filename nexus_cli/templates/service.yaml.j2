apiVersion: v1
kind: Service
metadata:
  name: {{ app.name }}
  namespace: {{ app.name }}
  labels:
    app: {{ app.name }}
    managed-by: nexus
spec:
  selector:
    app: {{ app.name }}
  ports:
    - name: http
      protocol: TCP
      port: 80
      targetPort: {{ app.port }}
{% if app.metricsPath and app.effective_metrics_port != app.port %}
    - name: metrics
      protocol: TCP
      port: {{ app.effective_metrics_port }}
      targetPort: {{ app.effective_metrics_port }}
{% endif %}
  type: {{ app.serviceType | tojson }}
