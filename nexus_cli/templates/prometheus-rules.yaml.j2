{# `app.name` below is interpolated raw (no `| tojson`), unlike every other
   template in nexus_cli/templates/. That's deliberate, not an oversight:
   here it sits inside PromQL label matchers inside a YAML block scalar
   (`expr: |`), where `| tojson` would inject JSON-string quoting into the
   PromQL and corrupt the alert expression rather than protect it. It's safe
   to leave raw because `app.name` is already regex-validated to
   `^[a-z0-9-]+$` (config.py's AppConfig._name) — a charset with no quotes,
   newlines, or PromQL metacharacters, so nothing here can break out of
   either the YAML block scalar or the PromQL expression. See
   docs/INTERVIEW-BRIEF.md for why the fix isn't applied uniformly. #}
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ app.name }}-availability
  namespace: monitoring
  labels:
    app: {{ app.name }}
    managed-by: nexus
spec:
  groups:
    - name: {{ app.name }}-availability.rules
      rules:
        - alert: NexusAppReplicaShortage
          expr: |
            sum by (namespace, deployment) (
              kube_deployment_status_replicas_available{namespace="{{ app.name }}", deployment="{{ app.name }}"}
            ) <
            sum by (namespace, deployment) (
              kube_deployment_spec_replicas{namespace="{{ app.name }}", deployment="{{ app.name }}"}
            )
          for: 2m
          labels:
            severity: warning
          annotations:
            summary: "{{ app.name }} replicas below desired"
            description: "Available replicas are below desired for deployment {{ app.name }} in {{ app.name }} namespace."
---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ app.name }}-restarts
  namespace: monitoring
  labels:
    app: {{ app.name }}
    managed-by: nexus
spec:
  groups:
    - name: {{ app.name }}-restarts.rules
      rules:
        - alert: NexusAppHighRestarts
          expr: |
            sum by (namespace, pod, container) (
              increase(kube_pod_container_status_restarts_total{namespace="{{ app.name }}", container="{{ app.name }}"}[5m])
            ) > 3
          for: 2m
          labels:
            severity: warning
          annotations:
            summary: "High restart rate for {{ app.name }}"
            description: "Container restarts exceeded 3 in 5m for {{ app.name }}."
